# Keep the build context small and avoid copying host-built artifacts into the
# image (host node_modules/.next must NOT overwrite what `npm ci`/build produce).
node_modules
.next
out
build

.git
.gitignore

# local env / tooling
.env*
.DS_Store
.vscode
.idea
npm-debug.log*

# docs / infra not needed at build time
README.md
CLAUDE.md
.claude
Makefile
docker-compose.yml
Dockerfile
.dockerignore
nginx
